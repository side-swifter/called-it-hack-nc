# Optional extras, off by default: set to true to enable
# The bet target gets a decoy bet about someone else so the real bet stays a surprise.
DECOY_ENABLED=false
# Every Sunday 21:00 (server local time) the group's lowest-chip player gets a Cortex-written dare. Set to true to enable.
WEEKLY_DARE=false

# Timezone for the weekly dare (Sunday 21:00 in this zone). Defaults to the server's timezone.
TZ=America/New_York
